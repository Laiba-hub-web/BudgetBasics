    },
    {
      "income": -1000,
      "expected": "validation error"
    }
  ],
  "goal_tests": [
    {
      "name": "Laptop Fund",
      "target": 60000,
      "current": 20000,
      "monthly": 5000,
      "expected_remaining": 40000,
      "expected_months": 8
    },
    {
      "name": "Emergency Buffer",
      "target": 30000,
      "current": 10000,
      "monthly": 4000,
      "expected_remaining": 20000,
      "expected_months": 5
    },
    {
      "name": "Invalid Goal",
      "target": -100,
      "current": 0,
      "monthly": 1000,
      "expected": "validation error"
    }
  ],
  "expense_tests": [
    {
      "date": "2026-09-01",
